const SHEET_NAME = '訂單';
const HEADERS = ['時間','姓名','品項分類','飲品','冷熱','尺寸','甜度','冰量','數量','單價','總價'];
function getSheet_() { const ss = SpreadsheetApp.getActiveSpreadsheet(); let sheet = ss.getSheetByName(SHEET_NAME); if (!sheet) { sheet = ss.insertSheet(SHEET_NAME); sheet.appendRow(HEADERS); sheet.setFrozenRows(1); sheet.getRange(1,1,1,HEADERS.length).setFontWeight('bold').setBackground('#8d1f26').setFontColor('#ffffff'); sheet.autoResizeColumns(1, HEADERS.length); } return sheet; }
function doPost(e) { try { const data = JSON.parse(e.postData.contents); const required = ['name','category','drink','temperature','size','sugar','ice','quantity','unitPrice','totalPrice']; required.forEach(k => { if (data[k] === undefined || data[k] === '') throw new Error('缺少欄位：' + k); }); getSheet_().appendRow([new Date(),data.name,data.category,data.drink,data.temperature,data.size,data.sugar,data.ice,Number(data.quantity),Number(data.unitPrice),Number(data.totalPrice)]); return json_({ok:true}); } catch (err) { return json_({ok:false,error:err.message}); } }
function doGet(e) { if (e.parameter.action !== 'status') return json_({ok:true,message:'Tea shop ordering API'}); const sheet=getSheet_(); const values=sheet.getDataRange().getDisplayValues(); const headers=values.shift()||HEADERS; const orders=values.map(row=>Object.fromEntries(headers.map((h,i)=>[({時間:'timestamp',姓名:'name',飲品:'drink',冷熱:'temperature',尺寸:'size',甜度:'sugar',冰量:'ice',數量:'quantity',總價:'totalPrice'})[h]||h,row[i]]))); return json_({ok:true,orders:orders.reverse()}); }
function json_(obj) { return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON); }
